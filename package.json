{
  "name": "umber-style-monorepo",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "prepare": "husky",
    "gen:publish-options": "node scripts/gen-publish-options.mjs",
    "build": "pnpm --filter \"./packages/*\" build",
    "smoke:packed": "pnpm build && node scripts/smoke-packed.mjs",
    "check:release-notes": "node scripts/check-release-notes.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "deprecate-alpha": "node scripts/deprecate-alpha.mjs",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:coverage": "pnpm -r test:coverage",
    "test:scripts": "node --test --experimental-test-coverage --test-coverage-include=scripts/*.mjs --test-coverage-exclude=scripts/*.test.mjs --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 scripts/*.test.mjs",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check:typography": "aiwg --all",
    "test:e2e": "pnpm --filter @umber-fixtures/e2e test:e2e",
    "test:e2e:dev": "pnpm --filter @umber-fixtures/e2e test:e2e:dev",
    "test:browser": "pnpm -r --if-present test:browser",
    "bench": "pnpm build && node bench/bin/local.mjs",
    "bench:gate": "pnpm build && node bench/bin/gate.mjs"
  },
  "devDependencies": {
    "ai-watermark-guard": "^0.2.0",
    "husky": "^9.1.7",
    "oxfmt": "^0.78.0",
    "oxfmt-quick": "^1.0.1"
  }
}
