{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["vitest/globals", "node"],
    "jsx": "react-jsx"
  },
  "include": ["src", "bench"],
  "exclude": [
    // Each of these declares the `Theme` of the default style for the whole program, and the
    // declarations differ, so each is compiled apart: tsconfig.augmentation.json and
    // tsconfig.defaultStyle.json.
    "src/augmentation.test.tsx",
    "src/index.test.ts",
    "src/defaultStyle.test.tsx"
  ]
}
