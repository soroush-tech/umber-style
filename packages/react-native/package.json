  "dependencies": {
    "@umber-style/core": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.2.8",
    "react-native": ">=0.76.0"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    }
  },
  "devDependencies": {
    "@umber-bench/shared": "workspace:*",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@umber-style/eslint-config": "workspace:*",
    "@vitest/coverage-v8": "^5.1.0",
    "jsdom": "^31.0.0",
    "oxlint": "^1.93.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-native": "^0.88.1",
    "typescript": "~7.0.2",
    "vitest": "^5.1.0"
  }
