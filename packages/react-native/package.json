  },
  "bugs": {
    "url": "https://github.com/soroush-tech/umber-style/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "oxlint --deny-warnings",
