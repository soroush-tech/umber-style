{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["vitest/globals", "node"]
  },
  "include": ["src", "bench"],
  "exclude": [
    // It declares the `Theme` of the default style for the whole program, which no other test uses:
    // tsconfig.defaultStyle.json.
    "src/defaultStyle.test.ts"
  ]
}
