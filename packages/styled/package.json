{
  "name": "@umber-style/styled",
  "version": "0.5.0",
  "description": "UmberStyle's styled as a default export: the styled of the React binding, with its server build for server components.",
  "keywords": [
    "styling",
    "styled",
    "react",
    "server-components",
    "typescript"
  ],
  "license": "MIT",
  "author": "Masoud Soroush <masoud@soroush.tech>",
  "homepage": "https://umber-style.soroush.design",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/soroush-tech/umber-style.git",
    "directory": "packages/styled"
  },
  "bugs": {
    "url": "https://github.com/soroush-tech/umber-style/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.mts",
          "default": "./dist/index.mjs"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      }
    },
    "main": "./dist/index.cjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.mts"
  },
  "scripts": {
    "build": "tsdown",
    "lint": "oxlint --deny-warnings",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@umber-style/react": "workspace:^"
  },
  "peerDependencies": {
    "react": "^19.2.8"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@umber-style/core": "workspace:*",
    "@umber-style/eslint-config": "workspace:*",
    "@vitest/coverage-v8": "^5.1.0",
    "jsdom": "^31.0.0",
    "oxlint": "^1.93.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsdown": "^0.23.7",
    "typescript": "~7.0.2",
    "vitest": "^5.1.0"
  }
}
