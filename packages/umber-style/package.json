{
  "name": "umber-style",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "author": "Masoud Soroush <masoud@soroush.tech>",
  "homepage": "https://umber-style.soroush.design",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/soroush-tech/umber-style.git",
    "directory": "packages/umber-style"
  },
  "bugs": {
    "url": "https://github.com/soroush-tech/umber-style/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./react": {
      "react-server": {
        "types": "./src/shared.server.ts",
        "default": "./src/react.server.ts"
      },
      "types": "./src/shared.ts",
      "react-native": "./src/react-native.ts",
      "default": "./src/react.ts"
    },
    "./react-native": "./src/react-native.ts",
    "./vue": "./src/vue.ts"
  },
  "scripts": {
    "lint": "oxlint --deny-warnings",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.native.json && tsc --noEmit -p tsconfig.server.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@umber-style/core": "workspace:*",
    "@umber-style/react": "workspace:*",
    "@umber-style/react-native": "workspace:*",
    "@umber-style/vue": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.2.8",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@umber-style/eslint-config": "workspace:*",
    "@vitest/coverage-v8": "^5.1.0",
    "jsdom": "^31.0.0",
    "oxlint": "^1.93.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~7.0.2",
    "vitest": "^5.1.0",
    "vue": "^3.5.45"
  }
}
