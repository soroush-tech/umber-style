{
  "name": "umber-style",
  "version": "0.4.0",
  "description": "UmberStyle in one package: the engine at the root, and the React, React Native and Vue bindings as subpaths.",
  "keywords": [
    "styling",
    "theme",
    "design-tokens",
    "css-variables",
    "react",
    "react-native",
    "vue",
    "ssr",
    "typescript"
  ],
  "license": "MIT",
  "author": "Masoud Soroush <masoud@soroush.tech>",
  "homepage": "https://umber-style.soroush.design",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/soroush-tech/umber-style.git",
    "directory": "packages/umber-style"
  },
  "bugs": {
    "url": "https://github.com/soroush-tech/umber-style/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./react": {
      "react-server": {
        "types": "./src/shared.server.ts",
        "default": "./src/react.server.ts"
      },
      "types": "./src/shared.ts",
      "react-native": "./src/react-native.ts",
      "default": "./src/react.ts"
    },
    "./react-native": "./src/react-native.ts",
    "./vue": "./src/vue.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.mts",
          "default": "./dist/index.mjs"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      },
      "./react": {
        "react-server": {
          "import": {
            "types": "./dist/shared.server.d.mts",
            "default": "./dist/react.server.mjs"
          },
          "require": {
            "types": "./dist/shared.server.d.cts",
            "default": "./dist/react.server.cjs"
          }
        },
        "react-native": {
          "import": {
            "types": "./dist/shared.d.mts",
            "default": "./dist/react-native.mjs"
          },
          "require": {
            "types": "./dist/shared.d.cts",
            "default": "./dist/react-native.cjs"
          }
        },
        "import": {
          "types": "./dist/shared.d.mts",
          "default": "./dist/react.mjs"
        },
        "require": {
          "types": "./dist/shared.d.cts",
          "default": "./dist/react.cjs"
        }
      },
      "./react-native": {
        "import": {
          "types": "./dist/react-native.d.mts",
          "default": "./dist/react-native.mjs"
        },
        "require": {
          "types": "./dist/react-native.d.cts",
          "default": "./dist/react-native.cjs"
        }
      },
      "./vue": {
        "import": {
          "types": "./dist/vue.d.mts",
          "default": "./dist/vue.mjs"
        },
        "require": {
          "types": "./dist/vue.d.cts",
          "default": "./dist/vue.cjs"
        }
      }
    },
    "main": "./dist/index.cjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.mts"
  },
  "scripts": {
    "build": "tsdown",
    "lint": "oxlint --deny-warnings",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.native.json && tsc --noEmit -p tsconfig.server.json && tsc --noEmit -p tsconfig.strict.json && tsc --noEmit -p tsconfig.strict.native.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@umber-style/core": "workspace:^",
    "@umber-style/react": "workspace:^",
    "@umber-style/react-native": "workspace:^",
    "@umber-style/vue": "workspace:^"
  },
  "peerDependencies": {
    "react": "^19.2.8",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@umber-style/eslint-config": "workspace:*",
    "@vitest/coverage-v8": "^5.1.0",
    "jsdom": "^31.0.0",
    "oxlint": "^1.93.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsdown": "^0.23.7",
    "typescript": "~7.0.2",
    "vitest": "^5.1.0",
    "vue": "^3.5.45"
  }
}
