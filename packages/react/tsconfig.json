{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["vitest/globals", "node"],
    "jsx": "react-jsx"
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/**/vitest.*.ts"],
  "files": [
    "src/augmentation.test.tsx",
    "src/webStyle.test.tsx",
    "src/webStyle.server.test.tsx",
    "src/styledSystem.types.test.tsx"
  ]
}
