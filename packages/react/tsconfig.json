{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["vitest/globals", "node"],
    "jsx": "react-jsx"
  },
  "include": ["src", "bench"],
  "exclude": [
    // A test helper that the tests import; it has no types of its own to check.
    "src/**/vitest.*.ts",
    // Compiled with the `react-server` condition: tsconfig.server.json.
    "src/serverTypes.test.tsx",
    // These give the default style an app's `Theme` (the one that augmentation.test.tsx declares for
    // the whole program), so they are compiled together with it: tsconfig.augmentation.json.
    "src/augmentation.test.tsx",
    "src/defaultStyle.test.tsx",
    "src/defaultStyle.server.test.tsx",
    "src/defaultStyle.ssr.test.tsx",
    "src/index.test.ts",
    "src/index.server.test.ts"
  ]
}
